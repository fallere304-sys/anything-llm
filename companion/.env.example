# AI相棒 設定ファイル。 .env にコピーして編集する(.env は git に入れない)。
# 秘密情報(APIキー等)はここにのみ書く。コードには書かない。

# --- サーバー ---
BUDDY_HOST=127.0.0.1
BUDDY_PORT=8765
# スマホ等から LAN 経由で使う場合は BUDDY_HOST=0.0.0.0 にし、トークンを必ず設定する。
# (127.0.0.1 以外で起動する場合、トークン未設定だと起動を拒否する)
BUDDY_ACCESS_TOKEN=

# --- データ ---
BUDDY_DATA_DIR=./data
BUDDY_SYSTEM_PROMPT_FILE=./prompts/system.md
# 会話履歴としてLLMに渡す最大文字数(おおよそのトークン予算の代用)
BUDDY_MAX_CONTEXT_CHARS=12000
# うち記憶(長期・プロジェクト・重要事項)に使う最大文字数
BUDDY_MAX_MEMORY_CHARS=3000

# --- LLM ---
# openai       : OpenAI API(クラウド)。LLM_API_KEY が必須。会話内容は OpenAI に送信される。
# openai_compat: OpenAI互換API(Ollama / LM Studio など)
# mock         : LLMなしで動作確認するためのダミー
# 注意: ChatGPT(Plus 等)の契約と OpenAI API の課金は別。APIキーは
#       https://platform.openai.com で発行し、利用料は従量課金になる。
LLM_PROVIDER=mock
LLM_API_KEY=
# モデル名はコードに書かない。使うモデルを OpenAI の最新ドキュメントで確認して指定する。
# fast  : 普段使い(雑談・短い質問)
# strong: 深く考えるとき(設計・分析など)。UI のモデル選択で切り替える(未設定なら fast のみ)
LLM_MODEL=
LLM_MODEL_STRONG=
# 空ならプロバイダ既定(openai: https://api.openai.com/v1 / openai_compat: http://localhost:11434/v1)
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=120

# --- 音声出力 ---
# none       : 無効
# mock       : ビープ音(動作確認用)
# voiceroid2 : VOICEROID2 琴葉茜・葵(Windows + `pip install pyvcroid2`。実機未検証)
TTS_PROVIDER=none
# 声の一覧は Windows で `python -m buddy.tts.voiceroid2` を実行して確認し、琴葉葵の名前を指定する
TTS_VOICE_NAME=
TTS_LANGUAGE=standard
TTS_SPEED=1.0
TTS_PITCH=1.0
TTS_VOLUME=1.0

# --- 連携(ChatGPT が司令塔として呼び出す) ---
# 外部サービスへの送信は、既定で毎回あなたの承認が必要(TOOL_AUTO_APPROVE で個別に省略可)。
# キーを空にした連携は無効になり、可視化画面でも「未設定」と表示される。

# Claude(成果物の作成)。APIキーは https://platform.claude.com で発行。Claude.ai の契約とは別の従量課金。
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# 思考の深さ: low / medium / high / xhigh / max(空なら指定しない)
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=32000
# 安全上の理由で辞退された場合に、Anthropic 側で別モデルへ自動で切り替える(off で無効)
CLAUDE_REFUSAL_FALLBACK=default

# Perplexity(調べ物)。使えるモデル名は Perplexity の最新ドキュメントで確認すること。
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Gemini(画像生成)。APIキーは Google AI Studio で発行。無料枠あり(回数制限はモデルにより異なり、
# AI Studio の Rate limits で確認)。無料枠では送信内容が Google の製品改善に使われる場合がある。
GEMINI_API_KEY=
# 画像生成モデル名(利用可能なものを AI Studio で確認)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# --- 作業フォルダ・エージェント ---
# AI が読めるのはこのフォルダの中だけ。成果物は outputs/ に新規保存される(上書きしない)。
BUDDY_WORKSPACE_DIR=./workspace
# 1回の依頼で LLM を呼ぶ最大回数(無限ループ防止)
AGENT_MAX_STEPS=6
AGENT_TOOL_TIMEOUT_SECONDS=600
AGENT_APPROVAL_TIMEOUT_SECONDS=900
# このレベル以下のツールは自動許可(0〜3)。外部送信と Lv4 は対象外。Lv4 は常に承認が必要。
TOOL_AUTO_APPROVE_MAX_LEVEL=1
# 外部送信でも毎回の承認を省くツール名(カンマ区切り)。例: research_web
TOOL_AUTO_APPROVE=
