# AI相棒 設定ファイル。 .env にコピーして編集する(.env は git に入れない)。
# 秘密情報(APIキー等)はここにのみ書く。コードには書かない。
#
# 既定の構成(B案):
#   会話 = Gemini(無料枠) / 司令塔 = Claude Code(Claude のサブスク枠) / 作成・調査・画像 = Gemini(無料枠)
# 必要なもの: Gemini の APIキー 1つ と、PC に Claude Code をインストールしてサブスクでログインしておくこと。

# ===== サーバー =====
BUDDY_HOST=127.0.0.1
BUDDY_PORT=8765
# 他の端末から使う場合のみ BUDDY_HOST=0.0.0.0 とトークンを設定(トークン未設定の公開は起動を拒否)
BUDDY_ACCESS_TOKEN=

# ===== データ =====
BUDDY_DATA_DIR=./data
BUDDY_SYSTEM_PROMPT_FILE=./prompts/system.md
# 会話履歴としてLLMに渡す最大文字数 / そのうち記憶(長期・プロジェクト・重要事項)に使う最大文字数
BUDDY_MAX_CONTEXT_CHARS=12000
BUDDY_MAX_MEMORY_CHARS=3000
# AI が読めるのはこのフォルダの中だけ。成果物は outputs/ に新規保存される(上書きしない)
BUDDY_WORKSPACE_DIR=./workspace

# ===== Gemini(会話・作成・調査・画像)=====
# APIキーは Google AI Studio で発行。無料枠あり(回数制限はモデルにより異なり、AI Studio の Rate limits で確認)。
# 注意: 無料枠では送信内容(会話・記憶を含む)が Google の製品改善に使われる場合がある。
GEMINI_API_KEY=
# モデル名は変わるので、キー設定後に次で使えるものを確認する:  python -m buddy.tools.gemini_api
LLM_PROVIDER=gemini
# 会話に使うモデル(速いもの)
LLM_MODEL=
# 深く考えるモデル(任意。UI のモデル選択で切替)
LLM_MODEL_STRONG=
# 文書作成・調査に使うモデル
GEMINI_TEXT_MODEL=
# 画像生成に使うモデル(例: gemini-3.1-flash-image)
GEMINI_IMAGE_MODEL=
LLM_TIMEOUT_SECONDS=120

# ===== 司令塔: Claude Code(Claude のサブスク枠)=====
# 複数ステップのタスクだけ Claude Code に任せる。最小構成で起動するため消費は小さい
# (実測: 既定構成 約31,900 → 最小構成 約1,200 入力トークン/回)。
# 事前に PC で `claude` を起動し、サブスク(Pro/Max)でログインしておくこと。
# 環境変数の ANTHROPIC_API_KEY は自動で外して起動する。それでも API キーで起動した場合は中止する(API 課金防止)。
ORCHESTRATOR=claude_code
# claude コマンドの場所(PATH に無い場合はフルパス)
CLAUDE_CODE_PATH=claude
# 空なら Claude Code の既定モデル
CLAUDE_CODE_MODEL=
CLAUDE_CODE_TIMEOUT_SECONDS=1800

# ===== 担当の切替 =====
WRITER_PROVIDER=gemini
RESEARCH_PROVIDER=gemini

# ===== 権限・エージェント =====
# このレベル以下のツールは自動許可(0〜3)。外部送信と Lv4 は対象外。Lv4 は常に承認が必要。
TOOL_AUTO_APPROVE_MAX_LEVEL=1
# 外部送信でも毎回の承認を省くツール名(カンマ区切り)。
# B案では会話自体が Gemini に送られているため、Gemini 系を省くと手間が減る(推奨):
#   TOOL_AUTO_APPROVE=research_web,create_document,generate_image
# delegate_task(Claude Code への依頼)は、承認を残すことを推奨。
TOOL_AUTO_APPROVE=
# 1回の依頼で会話 LLM を呼ぶ最大回数(無限ループ防止)
AGENT_MAX_STEPS=6
AGENT_TOOL_TIMEOUT_SECONDS=600
AGENT_APPROVAL_TIMEOUT_SECONDS=900

# ===== 音声出力 =====
# none / mock(ビープ) / voiceroid2(VOICEROID2 琴葉茜・葵。Windows + `pip install pyvcroid2`。実機未検証)
TTS_PROVIDER=none
# 声の一覧は Windows で `python -m buddy.tts.voiceroid2` を実行して確認し、琴葉葵の名前を指定する
TTS_VOICE_NAME=
TTS_LANGUAGE=standard
TTS_SPEED=1.0
TTS_PITCH=1.0
TTS_VOLUME=1.0

# ===== 任意: 別の経路(既定では使わない。いずれも API 課金) =====
# 会話を OpenAI にする:  LLM_PROVIDER=openai, LLM_API_KEY=..., LLM_MODEL=...
# 会話をローカルLLMにする: LLM_PROVIDER=openai_compat, LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=...
LLM_API_KEY=
LLM_BASE_URL=
# 文書作成を Claude API にする: WRITER_PROVIDER=claude_api(Claude.ai のサブスクとは別の従量課金)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=32000
CLAUDE_REFUSAL_FALLBACK=default
# 調査を Perplexity にする: RESEARCH_PROVIDER=perplexity(前払いクレジットが必要)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
