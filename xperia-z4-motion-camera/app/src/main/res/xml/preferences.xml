<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <Preference
        android:selectable="false"
        android:summary="@string/pref_note" />

    <PreferenceCategory android:title="@string/pref_cat_camera">
        <ListPreference
            android:defaultValue="640x480"
            android:entries="@array/resolution_entries"
            android:entryValues="@array/resolution_values"
            android:key="resolution"
            android:summary="%s"
            android:title="@string/pref_resolution" />
        <ListPreference
            android:defaultValue="10"
            android:entries="@array/fps_entries"
            android:entryValues="@array/fps_values"
            android:key="fps"
            android:summary="%s"
            android:title="@string/pref_fps" />
        <ListPreference
            android:defaultValue="0"
            android:entries="@array/rotation_entries"
            android:entryValues="@array/rotation_values"
            android:key="rotation"
            android:summary="%s"
            android:title="@string/pref_rotation" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_cat_motion">
        <ListPreference
            android:defaultValue="motion"
            android:entries="@array/detect_mode_entries"
            android:entryValues="@array/detect_mode_values"
            android:key="detect_mode"
            android:summary="%s"
            android:title="@string/pref_detect_mode" />
        <ListPreference
            android:defaultValue="2"
            android:entries="@array/person_sens_entries"
            android:entryValues="@array/person_sens_values"
            android:key="person_sens"
            android:summary="%s"
            android:title="@string/pref_person_sens" />
        <ListPreference
            android:defaultValue="2"
            android:entries="@array/sensitivity_entries"
            android:entryValues="@array/sensitivity_values"
            android:key="sensitivity"
            android:summary="%s"
            android:title="@string/pref_sensitivity" />
        <ListPreference
            android:defaultValue="10"
            android:entries="@array/post_record_entries"
            android:entryValues="@array/post_record_values"
            android:key="post_record_sec"
            android:summary="%s"
            android:title="@string/pref_post_record" />
        <ListPreference
            android:defaultValue="0"
            android:entries="@array/segment_entries"
            android:entryValues="@array/segment_values"
            android:key="segment_min"
            android:summary="@string/pref_segment_summary"
            android:title="@string/pref_segment" />
        <CheckBoxPreference
            android:defaultValue="true"
            android:key="timestamp"
            android:summary="@string/pref_timestamp_summary"
            android:title="@string/pref_timestamp" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_cat_storage">
        <CheckBoxPreference
            android:defaultValue="true"
            android:key="use_sd"
            android:title="@string/pref_use_sd" />
        <EditTextPreference
            android:defaultValue="500"
            android:inputType="number"
            android:key="min_free_mb"
            android:summary="@string/pref_min_free_summary"
            android:title="@string/pref_min_free" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_cat_network">
        <EditTextPreference
            android:defaultValue="8080"
            android:inputType="number"
            android:key="port"
            android:title="@string/pref_port" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_cat_remote">
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="remote_enabled"
            android:summary="@string/pref_remote_summary"
            android:title="@string/pref_remote" />
        <EditTextPreference
            android:defaultValue=""
            android:inputType="textPassword"
            android:key="password"
            android:summary="@string/pref_password_summary"
            android:title="@string/pref_password" />
        <EditTextPreference
            android:defaultValue="@string/default_external_host"
            android:inputType="textUri"
            android:key="external_host"
            android:summary="@string/pref_external_host_summary"
            android:title="@string/pref_external_host" />
        <EditTextPreference
            android:defaultValue="8443"
            android:inputType="number"
            android:key="remote_port"
            android:title="@string/pref_remote_port" />
        <CheckBoxPreference
            android:defaultValue="true"
            android:key="upnp"
            android:summary="@string/pref_upnp_summary"
            android:title="@string/pref_upnp" />
        <EditTextPreference
            android:defaultValue=""
            android:inputType="textUri"
            android:key="ddns_domain"
            android:summary="@string/pref_ddns_domain_summary"
            android:title="@string/pref_ddns_domain" />
        <EditTextPreference
            android:defaultValue=""
            android:inputType="textPassword"
            android:key="ddns_token"
            android:title="@string/pref_ddns_token" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="acme"
            android:summary="@string/pref_acme_summary"
            android:title="@string/pref_acme" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_cat_power">
        <EditTextPreference
            android:defaultValue="18"
            android:inputType="number"
            android:key="low_batt_pause"
            android:title="@string/pref_low_batt_pause" />
        <EditTextPreference
            android:defaultValue="50"
            android:inputType="number"
            android:key="low_batt_resume"
            android:title="@string/pref_low_batt_resume" />
        <CheckBoxPreference
            android:defaultValue="true"
            android:key="quiet_enabled"
            android:title="@string/pref_quiet_enabled" />
        <EditTextPreference
            android:defaultValue="03:00"
            android:inputType="time"
            android:key="quiet_start"
            android:title="@string/pref_quiet_start" />
        <EditTextPreference
            android:defaultValue="04:00"
            android:inputType="time"
            android:key="quiet_end"
            android:title="@string/pref_quiet_end" />
        <EditTextPreference
            android:defaultValue="80"
            android:inputType="number"
            android:key="quiet_keep_pct"
            android:title="@string/pref_quiet_keep_pct" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_cat_update">
        <CheckBoxPreference
            android:defaultValue="true"
            android:key="update_auto"
            android:title="@string/pref_update_auto" />
        <EditTextPreference
            android:defaultValue="@string/default_update_url"
            android:inputType="textUri"
            android:key="update_url"
            android:title="@string/pref_update_url" />
        <EditTextPreference
            android:defaultValue=""
            android:inputType="text"
            android:key="update_sha256"
            android:title="@string/pref_update_sha256" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_cat_system">
        <CheckBoxPreference
            android:defaultValue="true"
            android:key="autostart"
            android:title="@string/pref_autostart" />
        <CheckBoxPreference
            android:defaultValue="true"
            android:key="keep_front"
            android:summary="@string/pref_keep_front_summary"
            android:title="@string/pref_keep_front" />
    </PreferenceCategory>
</PreferenceScreen>
